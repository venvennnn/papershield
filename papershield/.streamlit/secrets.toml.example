# PaperShield secrets — copy to .streamlit/secrets.toml and fill in real values.
# Never commit the populated file.

# ── Nutrient API key ────────────────────────────────────────────────────────
# The hackathon provides dashboard login credentials at:
#   https://api.nutrient.io/campaigns/api-world-cloudx-ai-hackathon-2026/
#   username: api-world-cloudx-2026
#   password: 5746c8e69078fde0126109ce5f8c301f
#
# These are DASHBOARD LOGIN credentials — use them to sign into:
#   https://dashboard.nutrient.io
# Once signed in, go to the Data Extraction API section and copy your
# API key (it starts with pdf_live_...).
# Set that key here:
NUTRIENT_API_KEY = "pdf_live_your-key-here"

# Base URL for the Nutrient DWS APIs (default is correct for production)
NUTRIENT_BASE_URL = "https://api.nutrient.io"

# Set to "false" to use live Nutrient APIs (requires a valid pdf_live_ key above)
# Set to "true" (or omit) to run in demo mode with the prepared fixture PDF
DEMO_MODE = "true"

# Optional: LLM classifier (not required for deterministic MVP)
# OPENAI_API_KEY = ""
# LLM_CLASSIFIER_ENABLED = "false"
